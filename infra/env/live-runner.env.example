LIVE_RUNNER_ADDR=:8080
LIVE_RUNNER_STATE_DIR=/var/lib/live-runner
LIVE_RUNNER_PRESETS_FILE=/etc/runner/presets/live.yaml
# Generate once with: openssl rand -base64 32. Keep stable across restarts.
LIVE_RUNNER_MASTER_KEY=
# Leave broker token empty for Modules member-agent tunnel attachment.
# Set a >=32-character token only for standalone clients that send it.
LIVE_RUNNER_BROKER_TOKEN=
# Required, independent random >=32 characters.
LIVE_RUNNER_INTERNAL_MEDIA_TOKEN=
LIVEPEER_PUBLIC_RTMP_URL=rtmp://localhost:1935
LIVEPEER_PUBLIC_URL=http://localhost:8088
# Set true in production after configuring the HTTPS proxy.
LIVE_RUNNER_REQUIRE_HTTPS=false
LIVE_RUNNER_MAX_CONCURRENT=1
LIVE_RUNNER_OUTPUT_STALL_DEADLINE=20s
LIVE_RUNNER_OUTPUT_FAIL_DEADLINE=60s
# Optional shared GPU admission: same writable path in every runner on one GPU.
# GPU_ADMISSION_LOCK=/var/run/gpu-admission/encoder

# End abandoned sessions; deadlines persist across runner restarts.
LIVE_RUNNER_INITIAL_PUBLISH_TIMEOUT=5m
LIVE_RUNNER_RECONNECT_GRACE=2m
# Browser playback requires a TLS proxy and an HTTPS advertised URL.
# LIVEPEER_PUBLIC_URL=https://live.example.com
