# registry / image selection
REGISTRY=tztcloud
TAG=v2-local

# exposed ports
TRANSCODE_RUNNER_PORT=8086
ABR_RUNNER_PORT=8087
LIVE_RUNNER_PORT=8088
LIVE_SHARED_INGEST_PORT=1935
LIVEPEER_PUBLIC_RTMP_URL=rtmp://localhost:1935
# Set the real certificate-enabled public origin before starting the runner.
LIVEPEER_PUBLIC_URL=https://live.example.com
LIVE_RUNNER_REQUIRE_HTTPS=true
LIVE_RUNNER_MASTER_KEY=
LIVE_RUNNER_BROKER_TOKEN=
LIVE_RUNNER_INTERNAL_MEDIA_TOKEN=

# preset files mounted from infra/presets
TRANSCODE_PRESETS_FILE=nvidia-gtx1080-transcode.yaml
ABR_PRESETS_FILE=nvidia-gtx1080-abr.yaml
LIVE_PRESETS_FILE=live.yaml

# queue sizing
TRANSCODE_MAX_QUEUE_SIZE=2
ABR_MAX_QUEUE_SIZE=1


# docker logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# nvidia runtime
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
NVIDIA_DEVICE_COUNT=1

# optional container names
TRANSCODE_CONTAINER_NAME=transcode-runner
ABR_CONTAINER_NAME=abr-runner
LIVE_CONTAINER_NAME=live-runner

# End abandoned sessions; deadlines persist across runner restarts.
LIVE_RUNNER_INITIAL_PUBLISH_TIMEOUT=5m
LIVE_RUNNER_RECONNECT_GRACE=2m
# Browser playback requires a TLS proxy and an HTTPS advertised URL.
# LIVEPEER_PUBLIC_URL=https://live.example.com
